      "id": "7845770a-962f-412c-ab72-ca5a8ae6a862",
      "name": "Extract CSV Rows",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const metadata = $('Set Batch Metadata').first().json;\nconst sourceFile = String(metadata.file_path || '').split(/[\\\\/]/).pop();\nconst specs = {\n  'customers.csv': { table: 'customers', fields: ['customer_id','customer_name','market','city','customer_segment'], pk: 'customer_id' },\n  'products.csv': { table: 'products', fields: ['sku_id','product_name','category','shelf_life_days','unit_of_measure'], pk: 'sku_id' },\n  'carriers.csv': { table: 'carriers', fields: ['carrier_id','carrier_name','market'], pk: 'carrier_id' },\n  'orders.csv': { table: 'orders', fields: ['order_id','customer_id','carrier_id','market','order_date','promised_delivery_date','actual_delivery_date','order_status','currency_code'], pk: 'order_id' },\n  'order_lines.csv': { table: 'order_lines', fields: ['line_id','order_id','line_number','sku_id','ordered_qty','delivered_qty','unit_price_local','currency_code'], pk: 'line_id' },\n};\nconst spec = specs[sourceFile];\nconst input = $input.all().map(item => item.json);\nconst seen = new Set();\nconst valid = [];\nconst rejected = [];\nconst isIsoDate = value => {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(String(value ?? ''))) return false;\n  const d = new Date(`${value}T00:00:00Z`);\n  return !Number.isNaN(d.getTime()) && d.toISOString().slice(0,10) === value;\n};\nconst integer = value => /^-?\\d+$/.test(String(value ?? ''));\nfor (let i = 0; i < input.length; i++) {\n  const row = input[i] || {};\n  const errors = [];\n  if (!spec) {\n    errors.push(`Unsupported filename: ${sourceFile || '(blank)'}`);\n  } else {\n    const unexpected = Object.keys(row).filter(key => !spec.fields.includes(key));\n    const missing = spec.fields.filter(key => !Object.prototype.hasOwnProperty.call(row, key));\n    if (missing.length) errors.push(`Missing columns: ${missing.join(', ')}`);\n    if (unexpected.length) errors.push(`Unexpected columns: ${unexpected.join(', ')}`);\n    const allowedBlank = sourceFile === 'orders.csv' ? new Set(['actual_delivery_date']) : new Set();\n    for (const key of spec.fields) {\n      if (!allowedBlank.has(key) && (!Object.prototype.hasOwnProperty.call(row, key) || String(row[key] ?? '').trim() === '')) {\n        errors.push(`${key} is required`);\n      }\n    }\n    const keyValue = String(row[spec.pk] ?? '').trim();\n    if (keyValue) {\n      const key = `${spec.pk}:${keyValue}`;\n      if (seen.has(key)) errors.push(`Duplicate ${spec.pk}: ${keyValue}`);\n      seen.add(key);\n    }\n    if (sourceFile === 'customers.csv' || sourceFile === 'carriers.csv') {\n      if (!['US','IN'].includes(row.market)) errors.push('market must be US or IN');\n    }\n    if (sourceFile === 'products.csv') {\n      if (!integer(row.shelf_life_days) || Number(row.shelf_life_days) <= 0) errors.push('shelf_life_days must be a positive integer');\n    }\n    if (sourceFile === 'orders.csv') {\n      if (!['US','IN'].includes(row.market)) errors.push('market must be US or IN');\n      if (!['USD','INR'].includes(row.currency_code)) errors.push('currency_code must be USD or INR');\n      if ((row.market === 'US' && row.currency_code !== 'USD') || (row.market === 'IN' && row.currency_code !== 'INR')) errors.push('currency_code does not match market');\n      if (!['delivered','cancelled'].includes(row.order_status)) errors.push('order_status must be delivered or cancelled');\n      if (!isIsoDate(row.order_date)) errors.push('order_date must be a valid ISO date');\n      if (!isIsoDate(row.promised_delivery_date)) errors.push('promised_delivery_date must be a valid ISO date');\n      if (isIsoDate(row.order_date) && isIsoDate(row.promised_delivery_date) && row.promised_delivery_date < row.order_date) errors.push('promised_delivery_date precedes order_date');\n      if (row.actual_delivery_date && !isIsoDate(row.actual_delivery_date)) errors.push('actual_delivery_date must be blank or a valid ISO date');\n      if (row.order_status === 'cancelled' && String(row.actual_delivery_date ?? '').trim() !== '') errors.push('cancelled orders must have a blank actual_delivery_date');\n      if (row.order_status === 'delivered' && !String(row.actual_delivery_date ?? '').trim()) errors.push('delivered orders require actual_delivery_date');\n      if (isIsoDate(row.order_date) && isIsoDate(row.actual_delivery_date) && row.actual_delivery_date < row.order_date) errors.push('actual_delivery_date precedes order_date');\n    }\n    if (sourceFile === 'order_lines.csv') {\n      if (!integer(row.line_number) || Number(row.line_number) <= 0) errors.push('line_number must be a positive integer');\n      if (!integer(row.ordered_qty) || Number(row.ordered_qty) <= 0) errors.push('ordered_qty must be a positive integer');\n      if (!integer(row.delivered_qty) || Number(row.delivered_qty) < 0) errors.push('delivered_qty must be a nonnegative integer');\n      if (integer(row.ordered_qty) && integer(row.delivered_qty) && Number(row.delivered_qty) > Number(row.ordered_qty)) errors.push('delivered_qty cannot exceed ordered_qty');\n      if (!Number.isFinite(Number(row.unit_price_local)) || Number(row.unit_price_local) <= 0) errors.push('unit_price_local must be a positive number');\n      if (!['USD','INR'].includes(row.currency_code)) errors.push('currency_code must be USD or INR');\n      const pair = `${String(row.order_id ?? '').trim()}::${String(row.line_number ?? '').trim()}`;\n      const pairKey = `order_line_pair:${pair}`;\n      if (row.order_id && row.line_number && seen.has(pairKey)) errors.push(`Duplicate order_id + line_number: ${pair}`);\n      if (row.order_id && row.line_number) seen.add(pairKey);\n    }\n  }\n  if (errors.length) rejected.push({ row_number: i + 2, record: row, errors });\n  else valid.push(row);\n}\nconst rejectedCount = rejected.length;\nconst validCount = valid.length;\nconst errorSummary = rejectedCount\n  ? JSON.stringify(rejected.slice(0, 25).map(item => ({ row_number: item.row_number, errors: item.errors }))).slice(0, 4500)\n  : null;\nreturn [{ json: {\n  batch_id: metadata.batch_id,\n  started_at: metadata.started_at,\n  source_file: sourceFile,\n  file_path: metadata.file_path,\n  input_rows: input.length,\n  accepted_rows: validCount,\n  rejected_rows: rejectedCount,\n  valid_records: valid,\n  rejected_records: rejected,\n  error_summary: errorSummary,\n  foreign_key_note: 'Cross-file foreign keys and existing primary-key conflicts are enforced by PostgreSQL; any insert failure rolls back the file transaction.'\n} }];"
      },
